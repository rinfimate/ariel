# EditorConfig helps developers define and maintain consistent
# coding styles between different editors and IDEs
# editorconfig.org

root = true

# Disable formatting for generated/hand-crafted native build files
[android/build.gradle]
indent_style = space
indent_size = 2

[android/CMakeLists.txt]
indent_style = space
indent_size = 2

[*]

indent_style = space
indent_size = 2

end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
